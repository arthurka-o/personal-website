# Ignore docs files
_gh_pages
_site
.ruby-version
.sass-cache
.jekyll-cache

# Numerous always-ignore extensions
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.zip
*.vi
*~

# OS or Editor folders
.DS_Store
._*
Thumbs.db
.cache
.project
.settings
.tmproj
*.esproj
nbproject
*.sublime-project
*.sublime-workspace
.idea

# Komodo
*.komodoproject
.komodotools

# grunt-html-validation
validation-status.json
validation-report.json

# Folders to ignore
node_modules

# Build output. The rendered index.html is produced by `npm run build` and
# published by the Deploy workflow; it is deliberately not committed, so there
# is no generated file in the repository that could fall out of step with the
# content.js it was rendered from.
dist/

# Browser-session artifacts. The MCP browser writes a page snapshot and a
# console log per navigation into this directory; they are transcripts of a
# session, not source.
.playwright-mcp/

# Python bytecode from the CV build tools.
__pycache__/
